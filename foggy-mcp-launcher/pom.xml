<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foggysource</groupId>
        <artifactId>foggy-data-mcp-bridge</artifactId>
        <version>9.1.0.beta</version>
    </parent>

    <artifactId>foggy-mcp-launcher</artifactId>
    <packaging>jar</packaging>

    <name>Foggy MCP Launcher</name>
    <description>MCP 服务启动器 - 包含演示数据模型，可通过配置禁用</description>

    <dependencies>
        <!-- MCP 核心服务 -->
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Governed in-memory secondary analysis over result handles -->
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-memory-grid-bridge</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Demo 数据模型（可通过 foggy.demo.enabled=false 禁用） -->
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-demo</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Odoo 数据模型（可通过 spring.profiles.active=odoo 启用） -->
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-odoo-bridge-java</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Data Viewer（可通过 foggy.data-viewer.enabled=false 禁用） -->
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-data-viewer</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 云存储支持（阿里云OSS、华为云OBS、腾讯云COS、AWS S3） -->
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-chart-storage-cloud</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver（Odoo Bridge 等场景需要） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- SQLite JDBC Driver（lite profile 启动数据源） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.foggyframework.mcp.launcher.McpLauncherApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
