    model: fs,

    columnGroups: [
        {
            caption: '订单',
            items: [
                { ref: fs.orderId },
                { ref: fs.salesAmountFormulaLeafYuan }
            ]
        },
        {
            caption: '度量',
            items: [
                { ref: fs.salesAmountFormulaYuan },
                { ref: fs.salesAmountBuilderYuan },
                { ref: fs.taxDialectFormulaYuan }
            ]
        }
    ],

    accesses: []
};
