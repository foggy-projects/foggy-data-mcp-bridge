/**
 * 订单-销售明细聚合关系查询模型（accessBuilder RHS pushdown 回归样例）
 *
 * @caption 订单销售聚合关系权限下推查询
 * @description accessBuilder 使用字段引用 API 追加左侧 join key 过滤，引擎应同步下推到 RHS 聚合子查询
 */
const fo = loadTableModel('FactOrderModel');
const sales = loadTableModel('FactSalesModel');

const fs = sales
    .filterEq(sales.orderStatus, 'COMPLETED')
    .groupBy(sales.orderId)
    .as('fsByOrderAccess');

export const queryModel = {
    name: 'OrderSalesAggregateRelationAccessQueryModel',
    caption: '订单销售聚合关系权限下推查询',
    description: 'accessBuilder 使用字段引用 API 追加左侧 join key 过滤，引擎应同步下推到 RHS 聚合子查询',
    model: fo,

    joins: [
        fo.leftJoin(fs).on(fo.orderId, fs.orderId)
    ],

    columnGroups: [
        {
            caption: '订单信息',
            items: [
                { ref: fo.orderId },
                { ref: fo.orderStatus },
                { ref: fo.amount }
            ]
        },
        {
            caption: '销售明细聚合',
            items: [
                { ref: fs.salesAmount },
                { ref: fs.quantity },
                { ref: fs.uniqueCustomers }
            ]
        }
    ],

    accesses: [
        {
            queryBuilder: (context) => {
                context.query.and(fo.orderId, 'ORD20240101000001');
            }
        }
    ]
};
