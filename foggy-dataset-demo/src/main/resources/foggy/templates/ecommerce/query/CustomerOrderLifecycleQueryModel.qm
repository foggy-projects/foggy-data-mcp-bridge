/**
 * 客户订单生命周期查询模型
 *
 * @caption 客户订单生命周期查询
 * @description 支持首购客户 cohort、首购日期/月和 30/60/90 天复购率分析。
 */
const lifecycle = loadTableModel('CustomerOrderLifecycleModel');

export const queryModel = {
    name: 'CustomerOrderLifecycleQueryModel',
    caption: '客户订单生命周期查询',
    description: '客户生命周期派生查询模型，支持按首购日期、首购月份、首购渠道统计首购客户数、订单数、生命周期金额以及30/60/90天复购客户数；复购率可用 repurchase30dCustomerCount/customerCount、repurchase60dCustomerCount/customerCount、repurchase90dCustomerCount/customerCount 计算。',
    loader: 'v2',

    model: lifecycle,

    columnGroups: [
        {
            caption: '客户信息',
            items: [
                { ref: lifecycle.customerId },
                { ref: lifecycle.customerName }
            ]
        },
        {
            caption: '首购 cohort',
            items: [
                { ref: lifecycle.firstOrderDate },
                { ref: lifecycle.firstOrderMonth },
                { ref: lifecycle.firstOrderChannel }
            ]
        },
        {
            caption: '生命周期度量',
            items: [
                { ref: lifecycle.customerCount },
                { ref: lifecycle.orderCount },
                { ref: lifecycle.lifetimeAmount },
                { ref: lifecycle.repurchase30dCustomerCount },
                { ref: lifecycle.repurchase60dCustomerCount },
                { ref: lifecycle.repurchase90dCustomerCount }
            ]
        }
    ],

    accesses: []
};
