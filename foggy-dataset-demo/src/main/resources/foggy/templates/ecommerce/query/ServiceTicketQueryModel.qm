/**
 * 客服工单查询模型
 *
 * @caption 客服工单查询
 * @description SLA DSL_CTE parity fixture，支持按团队统计客服工单首响SLA。
 */
const st = loadTableModel('ServiceTicketModel');

export const queryModel = {
    name: 'ServiceTicketQueryModel',
    caption: '客服工单查询',
    description: '客服工单事实表查询模型，支持按团队统计工单首响SLA',
    loader: 'v2',

    model: st,

    columnGroups: [
        {
            caption: '工单信息',
            items: [
                { ref: st.ticketId },
                { ref: st.createdAt },
                { ref: st.firstResponseAt },
                { ref: st.resolvedAt },
                { ref: st.priority },
                { ref: st.status },
                { ref: st.channel }
            ]
        },
        {
            caption: '团队维度',
            items: [
                { ref: st.team },
                { ref: st.team$parentId },
                { ref: st.team$teamLevel },
                { ref: st.team$managerName },
                { ref: st.team$status }
            ]
        },
        {
            caption: '度量',
            items: [
                { ref: st.ticketCount }
            ]
        }
    ],

    accesses: []
};
