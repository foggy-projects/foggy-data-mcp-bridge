<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.foggysource</groupId>
        <artifactId>foggy-data-mcp-bridge</artifactId>
        <version>9.1.0.beta</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>foggy-dataset-model-preagg</artifactId>
    <packaging>jar</packaging>
    <name>Foggy Dataset Model Pre-Aggregation</name>
    <description>Pre-aggregation computation and scheduling module for TM/QM data model engine</description>

    <properties>
        <v934.preagg.failsafe.reportsDirectory>${project.build.directory}/failsafe-reports</v934.preagg.failsafe.reportsDirectory>
        <v934.preagg.failsafe.summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary.xml</v934.preagg.failsafe.summaryFile>
    </properties>

    <dependencies>
        <!-- 核心依赖 -->
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-model-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset</artifactId>
        </dependency>

        <!-- Spring Web (for REST API) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Scheduling -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-demo</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.42.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <reportsDirectory>${v934.preagg.failsafe.reportsDirectory}</reportsDirectory>
                    <summaryFile>${v934.preagg.failsafe.summaryFile}</summaryFile>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
