<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Client action for the OWL chat component -->
    <record id="foggy_chat_action" model="ir.actions.client">
        <field name="name">Foggy AI Chat</field>
        <field name="tag">foggy_mcp.foggy_chat_action_client</field>
    </record>

    <!-- Menu: AI Chat moved under Settings → Foggy MCP -->
    <menuitem id="foggy_mcp_user_menu_chat"
              name="Foggy AI Chat"
              parent="foggy_mcp_config_menu_root"
              action="foggy_chat_action"
              sequence="10"
              groups="base.group_user"/>
</odoo>
