<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Root menu under Settings for Foggy MCP -->
    <menuitem id="foggy_mcp_config_menu_root"
              name="Foggy MCP"
              parent="base.menu_administration"
              sequence="99"
              groups="base.group_user"/>

    <!-- Extend Settings form to add Foggy MCP configuration -->
    <record id="res_config_settings_view_form_foggy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.foggy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Foggy MCP" name="foggy_mcp" groups="base.group_system">
                    <block title="Quick Setup">
                        <setting string="Setup Wizard"
                                 help="Step-by-step guide to deploy Foggy MCP Server, initialize closure tables, and verify connection">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(foggy_setup_wizard_action)d"
                                            string="Launch Setup Wizard"
                                            type="action" class="btn-primary"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Foggy MCP Server Connection">
                        <setting string="Server URL" help="Base URL of the Foggy MCP Server">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_mcp_url" class="col-lg-3"/>
                                    <field name="foggy_mcp_url" class="col-lg-6"
                                           placeholder="http://foggy-mcp:8080"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Endpoint Path" help="MCP JSON-RPC endpoint path">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_mcp_endpoint" class="col-lg-3"/>
                                    <field name="foggy_mcp_endpoint" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Request Timeout" help="HTTP timeout in seconds">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_mcp_timeout" class="col-lg-3"/>
                                    <field name="foggy_mcp_timeout" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Test Connection" help="Verify connection to Foggy MCP Server">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="action_test_connection"
                                            string="Test Connection"
                                            type="object" class="btn-primary"/>
                                </div>
                                <field name="foggy_connection_status"
                                       class="mt16"
                                       nolabel="1"
                                       colspan="2"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Advanced Settings">
                        <setting string="Namespace" help="Model namespace for Foggy bundles">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_mcp_namespace" class="col-lg-3"/>
                                    <field name="foggy_mcp_namespace" class="col-lg-4"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Tool Cache TTL" help="How long to cache tool definitions (seconds)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_mcp_cache_ttl" class="col-lg-3"/>
                                    <field name="foggy_mcp_cache_ttl" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Auth Token" help="Bearer token for authenticating with Foggy MCP Server (leave empty if auth is disabled)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_mcp_auth_token" class="col-lg-3"/>
                                    <field name="foggy_mcp_auth_token" class="col-lg-6" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="AI Chat (LLM Configuration)">
                        <setting string="LLM Provider" help="Select your AI model provider for the embedded chat">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_llm_provider" class="col-lg-3"/>
                                    <field name="foggy_llm_provider" class="col-lg-4"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="API Key" help="API key for the selected LLM provider">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_llm_api_key" class="col-lg-3"/>
                                    <field name="foggy_llm_api_key" class="col-lg-6" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Model Name" help="Model identifier (e.g., gpt-4o-mini, claude-3-5-sonnet, deepseek-chat)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_llm_model" class="col-lg-3"/>
                                    <field name="foggy_llm_model" class="col-lg-4"
                                           placeholder="gpt-4o-mini"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="API Base URL" help="Custom endpoint URL (required for Ollama and custom providers)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_llm_base_url" class="col-lg-3"/>
                                    <field name="foggy_llm_base_url" class="col-lg-6"
                                           placeholder="http://localhost:11434/v1"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Temperature" help="Controls randomness (0.0 = deterministic, 1.0 = creative)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="foggy_llm_temperature" class="col-lg-3"/>
                                    <field name="foggy_llm_temperature" class="col-lg-2"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Business Context"
                                 help="Custom business knowledge injected into every AI conversation. Define your KPIs, terms, and rules here.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="foggy_llm_custom_prompt" class="col-lg-9"
                                           placeholder="Examples:&#10;- Key account = annual sales > 500,000&#10;- Active customer = ordered in the last 90 days&#10;- Our fiscal year starts in April&#10;- R&amp;D department includes QA and DevOps teams"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
