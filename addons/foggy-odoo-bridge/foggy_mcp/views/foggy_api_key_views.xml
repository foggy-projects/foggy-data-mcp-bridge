<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- API Key tree view -->
    <record id="foggy_api_key_view_tree" model="ir.ui.view">
        <field name="name">foggy.api.key.tree</field>
        <field name="model">foggy.api.key</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_id"/>
                <field name="key_short"/>
                <field name="active"/>
                <field name="last_used"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- API Key form view -->
    <record id="foggy_api_key_view_form" model="ir.ui.view">
        <field name="name">foggy.api.key.form</field>
        <field name="model">foggy.api.key</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_regenerate_key" string="Regenerate Key"
                            type="object" class="btn-warning"
                            confirm="This will invalidate the current key. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., Claude Desktop - Work Laptop"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="key" widget="CopyClipboardChar"/>
                            <field name="mcp_endpoint" widget="CopyClipboardChar"/>
                            <field name="last_used"/>
                        </group>
                    </group>
                    <group string="Restrictions">
                        <field name="company_ids" widget="many2many_tags"/>
                    </group>
                    <separator string="Connection Instructions"/>
                    <div class="alert alert-success" role="alert">
                        <p><strong>Ready-to-use Configuration:</strong></p>
                        <field name="mcp_config_html" widget="html" readonly="1" nolabel="1"/>
                        <p class="mb-0 text-muted"><small>Select the JSON text and press Ctrl+C / ⌘+C to copy. Or copy the API Key and MCP Endpoint individually above.</small></p>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <p><strong>Generic Template (for other environments):</strong></p>
                        <p>Replace <code>&lt;your-odoo-url&gt;</code> and <code>&lt;your-api-key&gt;</code> accordingly:</p>
                        <pre style="background:#f8f9fa; padding:12px; border-radius:4px; font-size:13px;">{
  "mcpServers": {
    "odoo": {
      "url": "https://&lt;your-odoo-url&gt;/foggy-mcp/rpc",
      "headers": {
        "Authorization": "Bearer &lt;your-api-key&gt;"
      }
    }
  }
}</pre>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- API Key action -->
    <record id="foggy_api_key_action" model="ir.actions.act_window">
        <field name="name">MCP API Keys</field>
        <field name="res_model">foggy.api.key</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an API Key
            </p>
            <p>
                API keys allow AI clients (Claude Desktop, Cursor, etc.)
                to securely connect to Odoo via the MCP protocol.
            </p>
        </field>
    </record>

    <!-- "My API Key" action — opens current user's key directly -->
    <record id="foggy_my_api_key_action" model="ir.actions.act_window">
        <field name="name">My API Key</field>
        <field name="res_model">foggy.api.key</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No API Key yet
            </p>
            <p>
                Click <strong>New</strong> to create your Foggy MCP API key,
                then use it with Claude Desktop, Cursor, or any MCP-compatible AI client.
            </p>
        </field>
    </record>

    <!-- ===== "My API Key" moved under Settings → Foggy MCP ===== -->
    <menuitem id="foggy_mcp_user_menu_my_key"
              name="MCP API Key"
              parent="foggy_mcp_config_menu_root"
              action="foggy_my_api_key_action"
              sequence="20"
              groups="base.group_user"/>

    <!-- ===== Admin menu (under Settings) ===== -->
    <menuitem id="foggy_mcp_menu_root"
              name="Foggy MCP"
              parent="base.menu_administration"
              sequence="100"/>

    <menuitem id="foggy_mcp_menu_api_keys"
              name="API Keys (All Users)"
              parent="foggy_mcp_menu_root"
              action="foggy_api_key_action"
              sequence="10"/>
</odoo>
