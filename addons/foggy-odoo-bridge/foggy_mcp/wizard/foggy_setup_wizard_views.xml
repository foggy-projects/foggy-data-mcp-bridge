<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Setup Wizard Form View
         ═══════════════════════════════════════════════════════════════ -->
    <record id="foggy_setup_wizard_view_form" model="ir.ui.view">
        <field name="name">foggy.setup.wizard.form</field>
        <field name="model">foggy.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Foggy MCP Setup">
                <field name="state" invisible="1"/>

                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="welcome,deploy,connection,datasource,closure,done"/>
                </header>

                <sheet>
                    <!-- Step 1: Welcome -->
                    <div invisible="state != 'welcome'">
                        <div class="oe_title mb24">
                            <h2>Welcome to Foggy MCP</h2>
                            <p class="text-muted">
                                This wizard will help you connect Odoo to AI assistants like Claude and Cursor.
                            </p>
                        </div>
                        <div class="alert alert-info" role="alert">
                            <strong>What you'll need:</strong>
                            <ul class="mb0 mt4">
                                <li>Docker installed on your server</li>
                                <li>Access to run terminal commands</li>
                                <li>~2 minutes</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Step 2: Deploy -->
                    <div invisible="state != 'deploy'">
                        <div class="oe_title mb16">
                            <h2>Deploy Foggy MCP Server</h2>
                            <p class="text-muted">
                                Database connection detected from Odoo config. Adjust if needed, then run the command in your terminal.
                            </p>
                        </div>

                        <!-- Docker Network Detection - Real network name (Docker socket mounted) -->
                        <div invisible="not docker_network_name" class="alert alert-success mb16" role="alert">
                            <strong>✓ Docker Network Detected:</strong>
                            <span>Odoo is running in Docker on network <code><field name="docker_network_name"/></code></span>
                            <br/>
                            <small>Foggy MCP will automatically join this network for seamless communication.</small>
                        </div>

                        <!-- Docker Network Detection - Inferred (no Docker socket) -->
                        <div invisible="not docker_network_detected or docker_network_name" class="alert alert-warning mb16" role="alert">
                            <strong>⚠️ Docker Environment Detected (No Socket)</strong>
                            <br/>
                            <small>Odoo is running in Docker but the Docker socket is not mounted.
                            The generated command includes a network placeholder - you'll need to find your network name.</small>
                            <br/>
                            <code style="margin-top: 4px; display: inline-block;">docker network ls</code>
                        </div>

                        <!-- Connection Mode Selection -->
                        <group string="连接模式" col="2">
                            <field name="connection_mode" widget="radio"/>
                        </group>

                        <!-- Docker Network Mode Settings -->
                        <div invisible="connection_mode != 'docker'" class="mb16">
                            <group string="▼ Docker 网络设置" col="4">
                                <field name="docker_network_input"
                                       placeholder="odoo_default"
                                       help="输入 Docker 网络名称，运行 `docker network ls` 查看可用网络"/>
                            </group>
                            <div class="alert alert-info mb8" role="alert">
                                <strong>💡 说明：</strong>
                                <span class="text-muted">Foggy 容器将加入此网络，通过 Docker 服务名访问数据库。</span>
                            </div>
                        </div>

                        <!-- Direct IP Mode Settings -->
                        <div invisible="connection_mode != 'direct_ip'" class="mb16">
                            <group string="▼ 直接 IP 连接设置" col="4">
                                <field name="custom_db_host"
                                       placeholder="192.168.1.100"
                                       help="输入 Odoo 数据库的 IP 地址"/>
                            </group>
                            <div class="alert alert-info mb8" role="alert">
                                <strong>💡 说明：</strong>
                                <span class="text-muted">Foggy 容器将通过 IP 地址直接访问数据库，适合生产环境。</span>
                            </div>
                        </div>

                        <!-- Database Config (Read-only from Odoo) -->
                        <group string="▼ 从 Odoo 配置自动读取（只读）" col="6">
                            <field name="db_host" readonly="1" force_save="1"/>
                            <field name="db_port" readonly="1" force_save="1"/>
                            <field name="db_user" readonly="1" force_save="1"/>
                            <field name="db_password" password="True" readonly="1" force_save="1"/>
                            <field name="db_name" readonly="1" force_save="1"/>
                            <field name="foggy_port"/>
                        </group>

                        <!-- Hidden fields for network info -->
                        <field name="docker_network_name" invisible="1"/>
                        <field name="docker_network_mode" invisible="1"/>
                        <field name="docker_network_detected" invisible="1"/>
                        <field name="docker_socket_available" invisible="1"/>

                        <group>
                            <button name="action_regenerate_command" string="Regenerate Command"
                                    type="object" class="btn-secondary btn-sm"/>
                        </group>

                        <separator string="Run this command in your terminal"/>
                        <field name="deploy_command"
                               widget="ace" options="{'mode': 'sh'}"
                               readonly="1" nolabel="1"
                               class="mb16"/>

                        <div class="alert alert-secondary" role="alert">
                            <strong>How to run:</strong>
                            <ol class="mb0 mt4">
                                <li>Click in the code box above and press <code>Ctrl+A</code> then <code>Ctrl+C</code> to copy</li>
                                <li>Open your terminal (SSH or local)</li>
                                <li>Paste and press Enter</li>
                                <li>Wait for "Started" message, then click Next below</li>
                            </ol>
                        </div>
                    </div>

                    <!-- Step 3: Connection Test -->
                    <div invisible="state != 'connection'">
                        <div class="oe_title mb16">
                            <h2>Test Connection</h2>
                            <p class="text-muted">
                                Verify Foggy MCP Server is running. Configuration will be saved automatically on success.
                            </p>
                        </div>

                        <!-- Docker network hint - Real network -->
                        <div invisible="not docker_network_name" class="alert alert-info mb8" role="alert">
                            <strong>Tip:</strong> Since both containers are on network <code><field name="docker_network_name"/></code>,
                            use <code>http://foggy-mcp:8080</code> as the URL.
                        </div>

                        <!-- Docker network hint - No socket, but in Docker -->
                        <div invisible="not docker_network_detected or docker_network_name" class="alert alert-info mb8" role="alert">
                            <strong>Tip:</strong> Both containers are on the same Docker network.
                            Use <code>http://foggy-mcp:8080</code> as the URL.
                        </div>

                        <group string="Foggy MCP Server URL">
                            <field name="foggy_url" placeholder="http://localhost:7108"/>
                        </group>

                        <group string="Result" invisible="not connection_status">
                            <field name="connection_status" nolabel="1"
                                   widget="text" readonly="1"/>
                        </group>

                        <div invisible="connection_status" class="alert alert-warning" role="alert">
                            Click <strong>Test Connection</strong> button below to verify.
                        </div>

                        <!-- Manual save button - show after successful test -->
                        <div invisible="not connection_status or '❌' in connection_status" class="alert alert-success mb16" role="alert">
                            <strong>✅ 测试成功！</strong>
                            <p class="mb0 mt4">
                                配置已自动保存。如需手动保存当前配置，请点击下方按钮。
                            </p>
                        </div>

                        <group invisible="not connection_status or '❌' in connection_status">
                            <button name="action_save_connection" string="保存当前配置"
                                    type="object" class="btn-secondary"/>
                        </group>
                    </div>

                    <!-- Step 4: Data Source -->
                    <div invisible="state != 'datasource'">
                        <div class="oe_title mb16">
                            <h2>Configure Data Source</h2>
                            <p class="text-muted">
                                Register Odoo database as a data source in Foggy MCP Server.
                            </p>
                        </div>

                        <!-- Connection Mode Summary -->
                        <div class="alert alert-info mb16" role="alert">
                            <strong>当前连接模式：</strong>
                            <span invisible="connection_mode != 'docker'">
                                <strong>Docker 网络模式</strong> - Foggy 容器通过 Docker 网络访问数据库
                                <br/>
                                <small>数据库主机：<code>postgres</code>（或从 Odoo 配置读取的服务名）</small>
                            </span>
                            <span invisible="connection_mode != 'direct_ip'">
                                <strong>直接 IP 连接</strong> - Foggy 容器通过 IP 地址访问数据库
                                <br/>
                                <small>数据库主机：<code><field name="custom_db_host" class="font-weight-bold"/></code></small>
                            </span>
                        </div>

                        <!-- Data Source Preview -->
                        <group string="数据源配置预览" col="4">
                            <field name="db_host" readonly="1" force_save="1" string="数据库主机"/>
                            <field name="db_port" readonly="1" force_save="1" string="数据库端口"/>
                            <field name="db_user" readonly="1" force_save="1" string="数据库用户"/>
                            <field name="db_name" readonly="1" force_save="1" string="数据库名称"/>
                        </group>

                        <group>
                            <button name="action_configure_datasource"
                                    string="注册数据源"
                                    type="object" class="btn-primary"/>
                        </group>

                        <group string="Result" invisible="not datasource_status">
                            <field name="datasource_status" nolabel="1"
                                   widget="text" readonly="1"/>
                        </group>
                    </div>

                    <!-- Step 5: Closure Tables -->
                    <div invisible="state != 'closure'">
                        <div class="oe_title mb16">
                            <h2>Initialize Closure Tables</h2>
                            <p class="text-muted">
                                Required for hierarchical queries (company tree, department tree, etc.).
                            </p>
                        </div>

                        <group>
                            <button name="action_init_closure_tables"
                                    string="Initialize Closure Tables"
                                    type="object" class="btn-primary"
                                    confirm="This will create 4 tables in your database. Continue?"/>
                        </group>

                        <group string="Result" invisible="not closure_status">
                            <field name="closure_status" nolabel="1"
                                   widget="text" readonly="1"/>
                        </group>

                        <div class="alert alert-secondary" role="alert">
                            <strong>Tables:</strong> res_company_closure, hr_department_closure, hr_employee_closure, res_partner_closure
                            <br/><br/>
                            <strong>Tip:</strong> You can skip this step if you don't need hierarchical queries, and run it later from Settings.
                        </div>
                    </div>

                    <!-- Step 5: Done -->
                    <div invisible="state != 'done'">
                        <div class="oe_title mb16">
                            <h2>🎉 Setup Complete!</h2>
                        </div>
                        <div class="alert alert-success" role="alert">
                            <p><strong>Foggy MCP is ready to use.</strong></p>
                            <p class="mt8 mb0">
                                Next step: Create an API Key to connect your AI assistant.
                            </p>
                        </div>
                    </div>
                </sheet>

                <!-- Footer -->
                <footer>
                    <button name="action_next" string="Next →"
                            type="object" class="btn-primary"
                            invisible="state not in ('welcome', 'deploy', 'connection', 'datasource')"/>
                    <button name="action_test_connection" string="Test Connection"
                            type="object" class="btn-primary"
                            invisible="state != 'connection'"/>
                    <button name="action_configure_datasource" string="注册数据源"
                            type="object" class="btn-primary"
                            invisible="state != 'datasource'"/>
                    <button name="action_init_closure_tables" string="Initialize Closure Tables"
                            type="object" class="btn-primary"
                            invisible="state != 'closure'"/>
                    <button name="action_skip_closure" string="Skip"
                            type="object" class="btn-secondary"
                            invisible="state != 'closure'"/>
                    <button name="action_finish" string="Create API Key"
                            type="object" class="btn-success"
                            invisible="state != 'done'"/>
                    <button name="action_prev" string="← Back"
                            type="object" class="btn-secondary"
                            invisible="state in ('welcome', 'done')"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="foggy_setup_wizard_action" model="ir.actions.act_window">
        <field name="name">Foggy MCP Setup</field>
        <field name="res_model">foggy.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu -->
    <menuitem id="foggy_mcp_menu_setup_wizard"
              name="Setup Wizard"
              parent="foggy_mcp_menu_root"
              action="foggy_setup_wizard_action"
              sequence="1"/>

</odoo>