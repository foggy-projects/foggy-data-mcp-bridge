    <properties>
        <java.version>17</java.version>
        <argLine>-Dfile.encoding=UTF-8</argLine>
        <!-- Unit and integration runners must be independently skippable. -->
        <skipUnitTests>false</skipUnitTests>
        <skipITs>false</skipITs>
        <!-- Default fail-closed; authority runners may relax upstream selector misses,
             while the report verifier still enforces the exact target report set. -->
        <surefire.failIfNoTests>true</surefire.failIfNoTests>
        <failsafe.failIfNoTests>true</failsafe.failIfNoTests>
        <failsafe.failIfNoSpecifiedTests>true</failsafe.failIfNoSpecifiedTests>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.3</maven-failsafe-plugin.version>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
        <!-- Empty by default. The v934-coverage profile fills these late-bound
             properties without replacing the repository JVM/UTF-8 argLine. -->
        <jacoco.ut.argLine></jacoco.ut.argLine>
        <jacoco.it.argLine></jacoco.it.argLine>
        <jacoco.ut.destFile>${project.build.directory}/jacoco-ut.exec</jacoco.ut.destFile>
        <jacoco.it.destFile>${project.build.directory}/jacoco-it.exec</jacoco.it.destFile>
        <v934.coverage.sessionId>${project.artifactId}</v934.coverage.sessionId>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Spring 版本 -->
        <spring.version>6.2.0</spring.version>
        <spring-boot.version>3.4.5</spring-boot.version>

        <!-- 框架内部版本 -->
        <foggy-framework.version>9.1.0.beta</foggy-framework.version>

        <!-- 第三方依赖版本 -->
        <alibaba-fastjson.version>2.0.57</alibaba-fastjson.version>
        <lombok.version>1.18.36</lombok.version>
        <swagger-annotations.version>1.5.20</swagger-annotations.version>
        <java-cup-runtime.version>11b-20160615</java-cup-runtime.version>
        <java-cup.version>11b-20160615</java-cup.version>
        <dateparser.version>1.0.11</dateparser.version>
        <jsqlparser.version>5.3</jsqlparser.version>
        <duckdb-jdbc.version>1.5.3.0</duckdb-jdbc.version>
        <mysql-connector-java.version>8.0.28</mysql-connector-java.version>
    </properties>

