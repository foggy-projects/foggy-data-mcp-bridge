<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.foggysource</groupId>
        <artifactId>foggy-data-mcp-bridge</artifactId>
        <version>9.1.0.beta</version>
    </parent>

    <artifactId>foggy-dataset-model</artifactId>
    <packaging>jar</packaging>
    <name>Foggy Dataset Model</name>
    <description>Core data model engine for TM/QM declarative dimension modeling and dynamic query</description>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <dependencies>

        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-model-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-model-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-model-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-model-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-model-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC Driver (测试用) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SQL Server JDBC Driver (测试用) -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SQLite JDBC Driver (测试用) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.42.0.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Hibernate SQLite Dialect (测试用) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>6.4.0.Final</version>
            <scope>test</scope>
        </dependency>

        <!-- Demo 数据模型（TM/QM 定义）- 测试用 -->
        <dependency>
            <groupId>com.foggysource</groupId>
            <artifactId>foggy-dataset-demo</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            9.3.3 entry gate only. This is intentionally narrower than the
            full 9.3.4 test/CI split and only owns lifecycle gate probes/ITs.
        -->
        <profile>
            <id>model-lifecycle</id>
            <properties>
                <v933.reportsDirectory>${project.build.directory}/v933-entry-gate/default</v933.reportsDirectory>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/lifecycle/**/*Test.java</include>
                            </includes>
                            <excludes>
                                <exclude>**/IT*.java</exclude>
                                <exclude>**/*IT.java</exclude>
                                <exclude>**/*IT$*.java</exclude>
                                <exclude>**/*ITCase.java</exclude>
                                <exclude>**/*ITCase$*.java</exclude>
                                <exclude>**/*E2E.java</exclude>
                                <exclude>**/*E2E$*.java</exclude>
                                <exclude>**/*E2ETest.java</exclude>
                                <exclude>**/*E2ETest$*.java</exclude>
                            </excludes>
                            <failIfNoTests>true</failIfNoTests>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                            <reportsDirectory>${v933.reportsDirectory}/surefire-reports</reportsDirectory>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/lifecycle/**/IT*.java</include>
                                <include>**/lifecycle/**/*IT.java</include>
                                <include>**/lifecycle/**/*ITCase.java</include>
                                <include>**/lifecycle/**/*E2E.java</include>
                            </includes>
                            <skipITs>${skipITs}</skipITs>
                            <failIfNoTests>true</failIfNoTests>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                            <reportsDirectory>${v933.reportsDirectory}/failsafe-reports</reportsDirectory>
                            <summaryFile>${v933.reportsDirectory}/failsafe-reports/failsafe-summary.xml</summaryFile>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Legacy predecessor-only multi-database replay. It is no longer
            active by default and is forbidden in the 9.3.4 authority path.
            Step 3 replaces these broad Surefire executions with the explicit
            five-database Failsafe matrix.
        -->
        <profile>
            <id>multi-db</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>test-mysql</id>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <systemPropertyVariables>
                                        <spring.profiles.active>docker</spring.profiles.active>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                            <execution>
                                <id>test-postgres</id>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <systemPropertyVariables>
                                        <spring.profiles.active>postgres</spring.profiles.active>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.12</version>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.77</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.62</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>CLASS</element>
                                            <includes>
                                                <include>com.foggyframework.dataset.db.model.impl.SemanticScaleSqlSupport</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>1.00</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>1.00</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            9.3.4 Step 4 authority gate. The execution data is produced and
            merged by the top-level coverage workflow; this profile only
            validates that external data and never installs a JaCoCo agent.
        -->
        <profile>
            <id>v934-coverage-model-check</id>
            <properties>
                <v934.coverage.model.dataFile>${project.build.directory}/v934-step4-coverage/__MISSING_EXTERNAL_MERGED_UNIT_ALL_REQUIRED_IT__.exec</v934.coverage.model.dataFile>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>v934-coverage-model-require-external-data</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>v934.coverage.model.dataFile</property>
                                            <regex>^/(?!.*__MISSING_EXTERNAL_MERGED_UNIT_ALL_REQUIRED_IT__).+$</regex>
                                            <regexMessage>Supply -Dv934.coverage.model.dataFile=&lt;absolute merged Unit+all-required-IT exec file&gt;.</regexMessage>
                                        </requireProperty>
                                        <requireFilesExist>
                                            <files>
                                                <file>${v934.coverage.model.dataFile}</file>
                                            </files>
                                            <message>The merged Unit+all-required-IT JaCoCo exec file is required.</message>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.12</version>
                        <executions>
                            <execution>
                                <id>v934-coverage-model-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${v934.coverage.model.dataFile}</dataFile>
                                    <haltOnFailure>true</haltOnFailure>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.77</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.62</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>CLASS</element>
                                            <includes>
                                                <include>com.foggyframework.dataset.db.model.impl.SemanticScaleSqlSupport</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>1.00</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>1.00</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
