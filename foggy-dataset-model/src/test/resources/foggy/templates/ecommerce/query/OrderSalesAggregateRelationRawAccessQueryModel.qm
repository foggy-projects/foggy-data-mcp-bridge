/**
 * 订单-销售明细聚合关系查询模型（raw SQL accessBuilder 不下推回归样例）
 *
 * @caption 订单销售聚合关系原生权限查询
 * @description accessBuilder 使用原生 SQL 追加左侧过滤，引擎不解析或猜测 RHS 聚合下推
 */
const fo = loadTableModel('FactOrderModel');
const sales = loadTableModel('FactSalesModel');

const fs = sales
    .filterEq(sales.orderStatus, 'COMPLETED')
    .groupBy(sales.orderId)
    .as('fsByOrderRawAccess');

export const queryModel = {
    name: 'OrderSalesAggregateRelationRawAccessQueryModel',
    caption: '订单销售聚合关系原生权限查询',
    description: 'accessBuilder 使用原生 SQL 追加左侧过滤，引擎不解析或猜测 RHS 聚合下推',
    loader: 'v2',

    model: fo,

    joins: [
        fo.leftJoin(fs).on(fo.orderId, fs.orderId)
    ],

    columnGroups: [
        {
            caption: '订单信息',
            items: [
                { ref: fo.orderId },
                { ref: fo.orderStatus },
                { ref: fo.amount }
            ]
        },
        {
            caption: '销售明细聚合',
            items: [
                { ref: fs.salesAmount },
                { ref: fs.quantity },
                { ref: fs.uniqueCustomers }
            ]
        }
    ],

    accesses: [
        {
            queryBuilder: (context) => {
                const t = fo.$alias;
                context.query.andSql(t + ".order_id = ?", 'ORD20240101000001');
            }
        }
    ]
};
