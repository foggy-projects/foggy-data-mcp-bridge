{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "对指定单模型执行数据查询（V3版本）。普通列表、过滤、排序、简单分组聚合优先使用 columns；复杂标量/窗口表达式使用 calculatedFields；同比/环比/YTD/MTD/rolling 使用 timeWindow；交叉表、小计/总计、树形行轴、父级占比或列基准比值使用 pivot。跨模型 Join/Union、派生查询、多 Plan 返回请改用 dataset.compose_script。",
  "properties": {
    "model": {
      "type": "string",
      "description": "模型名称，如 TmsCustomerModel"
    },
    "payload": {
      "type": "object",
      "description": "查询参数",
      "properties": {
        "route": {
          "type": "string",
          "enum": [
            "DSL_CTE"
          ],
          "description": "仅用于受控单模型 DSL_CTE recipe/stage contract。普通查询不要传；需要服务工单 SLA、行级日期差标记后再聚合、聚合后 NULL-safe ratio 时，可传 DSL_CTE 并配套 executable_plan.cte_plan。"
        },
        "executable_plan": {
          "type": "object",
          "description": "DSL_CTE 受控阶段计划。仅 route=DSL_CTE 时使用，必须包含 cte_plan.stages；不要放 raw SQL、数据库函数或自由公式。"
        },
        "executablePlan": {
          "type": "object",
          "description": "executable_plan 的 camelCase 兼容字段。仅 route=DSL_CTE 时使用。"
        },
        "calculatedFields": {
          "type": "array",
          "description": "计算字段定义（复杂表达式、窗口函数、跨当前分组占比或需指定 agg 时使用）。全局/当前分组占比可使用 CALCULATE(SUM(metric), REMOVE(dim))；分母必须写 NULLIF(CALCULATE(...), 0)。父级占比（如子品类占大类）不要用 REMOVE(childDim) 或 ROLLUP_TO，使用 pivot.metrics 的 parentShare。跨列首列/末列基准比值不要用 CELL_AT/AXIS_MEMBER，使用 pivot.metrics 的 baselineRatio。同比、环比、累计、滚动使用 timeWindow，不要使用 CALCULATE；与 timeWindow 联用时，只支持作用于 timeWindow 输出列的后置标量表达式，不要设置 agg、窗口字段或 CALCULATE。严禁使用未开放函数：ROLLUP_TO、CELL_AT、AXIS_MEMBER、AXIS_REF。",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "字段名称，在 columns 中引用"
              },
              "expression": {
                "type": "string",
                "description": "表达式，支持算术运算、函数、窗口函数(RANK/ROW_NUMBER/LAG等)，以及受限 CALCULATE(SUM(metric), REMOVE(groupByDim))"
              },
              "agg": {
                "type": "string",
                "enum": [
                  "SUM",
                  "AVG",
                  "MAX",
                  "MIN",
                  "COUNT",
                  "COUNT_DISTINCT",
                  "STDDEV_POP",
                  "STDDEV_SAMP",
                  "VAR_POP",
                  "VAR_SAMP"
                ],
                "description": "聚合类型，groupBy 场景使用"
              },
              "partitionBy": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "窗口函数 PARTITION BY 字段列表"
              },
              "windowOrderBy": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "dir": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    }
                  }
                },
                "description": "窗口函数 ORDER BY"
              },
              "windowFrame": {
                "type": "string",
                "description": "窗口帧，如 ROWS BETWEEN 6 PRECEDING AND CURRENT ROW"
              }
            },
            "required": [
              "name",
              "expression"
            ]
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "普通查询字段列表；开启 pivot 时不要传 columns。支持内联聚合，例如 'sum(amount)' 或 'count(orderId) as cnt'，无需单独写 groupBy。交叉表、小计/总计、树形行轴、parentShare、baselineRatio 应改用 pivot。"
        },
        "slice": {
          "type": "array",
          "description": "过滤条件（数组内条件默认 AND 连接，用 $or/$and 显式组合）。简写：{ \"field\": \"value\" } 等价于 { \"field\": \"field\", \"op\": \"=\", \"value\": \"value\" }",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "description": "单个过滤条件",
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "字段名"
                  },
                  "op": {
                    "type": "string",
                    "description": "操作符：=, !=, >, <, like, in, [], [), is null 等"
                  },
                  "value": {
                    "description": "过滤值，is null/is not null 时不需要；字段引用用 {\"$field\": \"fieldName\"}"
                  },
                  "maxDepth": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "父子层级操作符的最大递归深度，仅 childrenOf/descendantsOf/selfAndDescendantsOf/ancestorsOf/selfAndAncestorsOf 等操作符使用"
                  }
                },
                "required": [
                  "field",
                  "op"
                ]
              },
              {
                "type": "object",
                "description": "$expr 表达式条件：字段间比较，支持算术运算",
                "properties": {
                  "$expr": {
                    "type": "string",
                    "description": "表达式如 \"salesAmount > costAmount * 1.2\""
                  }
                },
                "required": [
                  "$expr"
                ]
              },
              {
                "type": "object",
                "description": "OR 条件组",
                "properties": {
                  "$or": {
                    "type": "array",
                    "description": "子条件用 OR 连接",
                    "items": {
                      "$ref": "#/properties/payload/properties/slice/items"
                    }
                  }
                },
                "required": [
                  "$or"
                ]
              },
              {
                "type": "object",
                "description": "AND 条件组",
                "properties": {
                  "$and": {
                    "type": "array",
                    "description": "子条件用 AND 连接",
                    "items": {
                      "$ref": "#/properties/payload/properties/slice/items"
                    }
                  }
                },
                "required": [
                  "$and"
                ]
              },
              {
                "type": "object",
                "description": "等值条件简写：{ \"fieldName\": value }，运行时自动转换为 { \"field\": \"fieldName\", \"op\": \"=\", \"value\": value }",
                "minProperties": 1,
                "maxProperties": 1,
                "propertyNames": {
                  "not": {
                    "enum": ["$or", "$and", "$expr", "field", "op", "value", "maxDepth"]
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "having": {
          "type": "array",
          "description": "聚合后过滤条件（SQL HAVING）。只放预定义聚合 measure 或聚合表达式别名，例如 {\"field\":\"arOverdueAmount\",\"op\":\">\",\"value\":0}；普通明细字段过滤必须继续使用 slice。",
          "items": {
            "$ref": "#/properties/payload/properties/slice/items"
          }
        },
        "orderBy": {
          "type": "array",
          "description": "普通查询排序规则。支持简写：\"field\"(升序)、\"field desc\"(降序)、\"-field\"(降序)。pivot 模式下不要依赖顶层 orderBy 裁剪透视轴；如需 TopN 或轴内排序，请使用 pivot.rows[*].orderBy 或 pivot.columns[*].orderBy。",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "简写格式：\"field\"=升序，\"field desc\"=降序，\"-field\"=降序"
              },
              {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "排序字段"
                  },
                  "dir": {
                    "type": "string",
                    "enum": [
                      "asc",
                      "desc",
                      "ASC",
                      "DESC"
                    ],
                    "default": "asc"
                  },
                  "nullFirst": {
                    "type": "boolean"
                  },
                  "nullLast": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "field"
                ]
              }
            ]
          }
        },
        "groupBy": {
          "type": "array",
          "description": "分组配置。支持简写：\"field\" 等价于 { \"field\": \"field\" }",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "简写格式：字段名"
              },
              {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "agg": {
                    "type": "string",
                    "enum": [
                      "MAX",
                      "MIN",
                      "SUM",
                      "AVG",
                      "COUNT",
                      "COUNT_DISTINCT",
                      "STDDEV_POP",
                      "STDDEV_SAMP",
                      "VAR_POP",
                      "VAR_SAMP",
                      "PK"
                    ]
                  }
                },
                "required": [
                  "field"
                ]
              }
            ]
          }
        },
        "timeWindow": {
          "type": "object",
          "description": "声明式时间窗口分析。用于同环比、累计、滚动窗口；优先于手写窗口 calculatedFields。派生列会自动生成，可在 columns 中引用，如 salesAmount__prior、salesAmount__diff、salesAmount__ratio、salesAmount__rolling_7d、salesAmount__mtd、salesAmount__ytd。",
          "properties": {
            "field": {
              "type": "string",
              "description": "业务时间字段，通常使用 timeRole=business_date 的维度 id 字段，如 salesDate$id"
            },
            "grain": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "description": "分析粒度"
            },
            "comparison": {
              "type": "string",
              "enum": [
                "yoy",
                "mom",
                "wow",
                "ytd",
                "mtd",
                "rolling_7d",
                "rolling_30d",
                "rolling_90d"
              ],
              "description": "时间窗口类型：yoy/mom/wow 为同期比较，ytd/mtd 为累计，rolling_* 为滚动窗口"
            },
            "range": {
              "type": "string",
              "enum": [
                "[)",
                "[]"
              ],
              "description": "日期范围边界语义，默认 [)"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "可选当前期间 [start, end]。不传则由查询条件和引擎窗口规则决定；传入时必须恰好两个日期或相对表达式，如 [\"2025-01-01\", \"2026-01-01\"]、[\"-1Y\", \"now\"]。"
            },
            "targetMetrics": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "需要派生时间窗口列的度量字段，如 [\"salesAmount\"]。不填时默认作用于可用度量。"
            },
            "rollingAggregator": {
              "type": "string",
              "enum": [
                "sum",
                "avg",
                "count",
                "min",
                "max"
              ],
              "description": "rolling_* / ytd / mtd 的窗口聚合函数；默认 sum"
            }
          },
          "required": [
            "field",
            "grain",
            "comparison"
          ]
        },
        "start": {
          "type": "integer",
          "default": 0,
          "description": "起始行号"
        },
        "limit": {
          "type": "integer",
          "default": 1000,
          "description": "普通查询每页记录数。pivot 模式下不要依赖顶层 limit 裁剪透视轴；如需限制行/列成员数量，请使用 pivot.rows[*].limit 或 pivot.columns[*].limit，并通过 slice 收窄数据域。"
        },
        "returnTotal": {
          "type": "boolean",
          "default": false,
          "description": "是否返回总记录数"
        },
        "distinct": {
          "type": "boolean",
          "default": false,
          "description": "是否去重（SELECT DISTINCT）。适用于'列出所有…'类查询，与 groupBy 互斥"
        },
        "withSubtotals": {
          "type": "boolean",
          "default": false,
          "description": "是否追加小计/总计行。对 groupBy 聚合结果追加分组小计和总计行，通过 _rowType 字段标记（data/subtotal/grandTotal）"
        },
        "pivot": {
          "type": "object",
          "description": "多维透视分析模型。用于交叉表、行/列维度转置、小计/总计、树形 rows 轴、父级占比 parentShare、列基准比值 baselineRatio。开启 pivot 时必须移除 columns，且不能与 timeWindow 同用；如用户同时要求同比/环比和透视，应先拆成两个查询或优先 timeWindow 普通聚合。",
          "properties": {
            "rows": {
              "type": "array",
              "description": "行轴维度定义。需要层级树时只能在 rows 轴设置 hierarchyMode=tree，并使用 outputFormat=tree。",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "hierarchyMode": {
                        "type": "string",
                        "enum": [
                          "flat",
                          "tree"
                        ]
                      },
                      "expandDepth": {
                        "type": "integer"
                      },
                      "limit": {
                        "type": "integer"
                      },
                      "orderBy": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "having": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "metric": {
                              "type": "string"
                            },
                            "op": {
                              "type": "string",
                              "enum": [
                                ">",
                                ">=",
                                "<",
                                "<=",
                                "=",
                                "!="
                              ]
                            },
                            "value": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "metric",
                            "op",
                            "value"
                          ]
                        }
                      }
                    },
                    "required": [
                      "field"
                    ]
                  }
                ]
              }
            },
            "columns": {
              "type": "array",
              "description": "列轴维度定义。columns 轴不支持 hierarchyMode=tree；需要跨列首列/末列基准比较时配合 baselineRatio。",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "hierarchyMode": {
                        "type": "string",
                        "enum": [
                          "flat",
                          "tree"
                        ]
                      },
                      "expandDepth": {
                        "type": "integer"
                      },
                      "limit": {
                        "type": "integer"
                      },
                      "orderBy": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "having": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "metric": {
                              "type": "string"
                            },
                            "op": {
                              "type": "string",
                              "enum": [
                                ">",
                                ">=",
                                "<",
                                "<=",
                                "=",
                                "!="
                              ]
                            },
                            "value": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "metric",
                            "op",
                            "value"
                          ]
                        }
                      }
                    },
                    "required": [
                      "field"
                    ]
                  }
                ]
              }
            },
            "metrics": {
              "type": "array",
              "description": "度量指标列表。支持字符串（原生度量名）和对象（受控派生指标）。派生指标当前支持 parentShare（rows 轴父级占比）和 baselineRatio（columns 轴 first/last 基准比值）；不支持 expr、ROLLUP_TO、CELL_AT、AXIS_MEMBER。示例：[\"salesAmount\", {\"name\":\"share\",\"type\":\"parentShare\",\"of\":\"salesAmount\"}, {\"name\":\"index\",\"type\":\"baselineRatio\",\"of\":\"salesAmount\",\"axis\":\"columns\",\"baseline\":\"first\"}]",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": "原生度量名称"
                  },
                  {
                    "type": "object",
                    "description": "派生指标定义。支持 parentShare 和 baselineRatio。不支持 expr。严禁使用 ROLLUP_TO/CELL_AT/AXIS_MEMBER。",
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string", "description": "指标名称" },
                          "type": { "type": "string", "enum": ["parentShare"], "description": "派生类型。parentShare=子级值/父级聚合值；仅 rows 轴相邻层级，不支持 tree/cascade/having/orderBy/limit" },
                          "of": { "type": "string", "description": "基于哪个原生度量（parentShare 必填）" },
                          "axis": { "type": "string", "enum": ["rows"], "description": "指定轴（第一版仅支持 rows）" },
                          "level": { "type": "string", "description": "当前级别字段名" },
                          "parentLevel": { "type": "string", "description": "父级字段名" }
                        },
                        "required": ["name", "type", "of"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string", "description": "指标名称" },
                          "type": { "type": "string", "enum": ["baselineRatio"], "description": "派生类型。baselineRatio=当前值/基准值；仅 columns 轴 first/last 基准，不支持 tree/cascade/having/orderBy/limit" },
                          "of": { "type": "string", "description": "基于哪个原生度量" },
                          "axis": { "type": "string", "enum": ["columns"], "description": "指定轴（第一版仅支持 columns）" },
                          "baseline": { "type": "string", "enum": ["first", "last"], "description": "基准（第一版支持 first/last）" }
                        },
                        "required": ["name", "type", "of", "axis", "baseline"],
                        "additionalProperties": false
                      }
                    ]
                  }
                ]
              }
            },
            "properties": {
              "type": "array",
              "description": "需要随维度查出的附加属性，不改变聚合粒度。",
              "items": {
                "type": "string"
              }
            },
            "options": {
              "type": "object",
              "description": "透视高级计算选项。hierarchyMode=tree 与 crossjoin、rowSubtotals、columnSubtotals、grandTotal 互斥；parentShare/baselineRatio 不能参与 having/orderBy/limit/cascade TopN。",
              "properties": {
                "crossjoin": {
                  "type": "boolean",
                  "description": "补齐行列轴笛卡尔骨架。不能与 hierarchyMode=tree 同用；域值过大时引擎会 fail-closed，应收窄 slice 或降低轴 limit。"
                },
                "rowSubtotals": {
                  "type": "boolean",
                  "description": "行小计。不能与 hierarchyMode=tree 同用。"
                },
                "columnSubtotals": {
                  "type": "boolean",
                  "description": "列小计。不能与 hierarchyMode=tree 同用。"
                },
                "grandTotal": {
                  "type": "boolean",
                  "description": "总计。不能与 hierarchyMode=tree 同用。"
                }
              }
            },
            "layout": {
              "type": "object",
              "description": "客户端透视表布局参数。",
              "properties": {
                "metricPlacement": {
                  "type": "string",
                  "enum": [
                    "columns",
                    "rows"
                  ]
                }
              }
            },
            "outputFormat": {
              "type": "string",
              "enum": [
                "flat",
                "tree",
                "grid"
              ],
              "description": "期望格式。默认 flat。"
            }
          },
          "required": [
            "rows",
            "metrics"
          ]
        }
      },
      "allOf": [
        {
          "not": {
            "allOf": [
              {
                "required": [
                  "pivot"
                ]
              },
              {
                "required": [
                  "columns"
                ]
              }
            ]
          },
          "errorMessage": "不能同时出现 pivot 和 columns"
        },
        {
          "not": {
            "allOf": [
              {
                "required": [
                  "pivot"
                ]
              },
              {
                "required": [
                  "timeWindow"
                ]
              }
            ]
          },
          "errorMessage": "不能同时出现 pivot 和 timeWindow"
        }
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "execute",
        "validate"
      ],
      "default": "execute",
      "description": "execute(执行), validate(仅验证)"
    }
  },
  "required": [
    "model",
    "payload"
  ]
}
