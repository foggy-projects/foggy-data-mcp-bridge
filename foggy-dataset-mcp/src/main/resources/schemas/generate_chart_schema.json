{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "使用指定渲染引擎的原生配置生成图片。默认在当前 Java 进程中使用 XChart，不做 XChart 与 ECharts 之间的配置转换。",
  "properties": {
    "engine": {
      "type": "string",
      "enum": ["xchart", "echarts"],
      "default": "xchart",
      "description": "渲染引擎。xchart 在 JVM 内直接渲染；echarts 将 config 作为原生 ECharts Option 发送到可选外部渲染服务。"
    },
    "config": {
      "type": "object",
      "minProperties": 1,
      "description": "引擎原生配置。engine=xchart 时按 XChart builder/styler/series 格式；engine=echarts 时就是完整 ECharts Option。"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "description": "必填且非空的数据对象数组。XChart 通过字段绑定读取；ECharts 适配器会放入 Option.dataset.source。",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "image": {
      "type": "object",
      "description": "图片输出参数；这只是渲染结果封装，不参与图表配置转换。"
    }
  },
  "required": ["config", "data"],
  "additionalProperties": false,
  "oneOf": [
    {
      "title": "XChart JVM renderer",
      "properties": {
        "engine": {
          "enum": ["xchart"]
        },
        "config": {
          "$ref": "#/definitions/xchartConfig"
        },
        "image": {
          "$ref": "#/definitions/xchartImage"
        }
      }
    },
    {
      "title": "ECharts native Option renderer",
      "required": ["engine"],
      "properties": {
        "engine": {
          "const": "echarts"
        },
        "config": {
          "type": "object",
          "minProperties": 1,
          "description": "完整、原生的 ECharts Option；不接受也不转换 XChart 配置。",
          "additionalProperties": true
        },
        "image": {
          "$ref": "#/definitions/echartsImage"
        }
      }
    }
  ],
  "definitions": {
    "xchartConfig": {
      "type": "object",
      "minProperties": 1,
      "required": ["chartType"],
      "properties": {
        "chartType": {
          "type": "string",
          "enum": ["CategoryChart", "XYChart", "PieChart"],
          "description": "XChart 图表类。CategoryChart 适合柱状/分类折线/面积图；XYChart 适合数值坐标折线/散点图；PieChart 适合饼图/环图。"
        },
        "title": {
          "type": "string",
          "description": "XChart builder.title"
        },
        "xAxisTitle": {
          "type": "string",
          "description": "XChart CategoryChartBuilder/XYChartBuilder.xAxisTitle"
        },
        "yAxisTitle": {
          "type": "string",
          "description": "XChart CategoryChartBuilder/XYChartBuilder.yAxisTitle"
        },
        "theme": {
          "type": "string",
          "enum": ["XChart", "GGPlot2", "Matlab"],
          "description": "XChart builder.theme"
        },
        "nameField": {
          "type": "string",
          "description": "PieChart 数据绑定：从顶层 data 读取扇区名称。必须与 valueField 同时使用。"
        },
        "valueField": {
          "type": "string",
          "description": "PieChart 数据绑定：从顶层 data 读取扇区数值。必须与 nameField 同时使用。"
        },
        "renderStyle": {
          "type": "string",
          "enum": ["Pie", "Donut"],
          "description": "PieChart 使用 nameField/valueField 时的系列样式。"
        },
        "styler": {
          "type": "object",
          "description": "XChart Styler setter 的 JSON 表达；字段名与 setter 去掉 set 后的属性含义一致。",
          "properties": {
            "legendVisible": { "type": "boolean" },
            "legendPosition": {
              "type": "string",
              "enum": ["OutsideE", "InsideNW", "InsideNE", "InsideSE", "InsideSW", "InsideN", "InsideS", "OutsideS"]
            },
            "chartTitleVisible": { "type": "boolean" },
            "plotBorderVisible": { "type": "boolean" },
            "plotGridLinesVisible": { "type": "boolean" },
            "axisTitlesVisible": { "type": "boolean" },
            "axisTicksVisible": { "type": "boolean" },
            "labelsVisible": { "type": "boolean" },
            "stacked": { "type": "boolean" },
            "overlapped": { "type": "boolean" },
            "availableSpaceFill": { "type": "number" },
            "defaultSeriesRenderStyle": {
              "type": "string",
              "description": "CategoryChart: Bar/Line/Area/Scatter/SteppedBar/Stick；XYChart: Line/Area/Step/StepArea/PolygonArea/Scatter；PieChart: Pie/Donut。"
            },
            "xAxisLabelRotation": { "type": "integer" },
            "xAxisMin": { "type": "number" },
            "xAxisMax": { "type": "number" },
            "yAxisMin": { "type": "number" },
            "yAxisMax": { "type": "number" },
            "xAxisLogarithmic": { "type": "boolean" },
            "yAxisLogarithmic": { "type": "boolean" },
            "decimalPattern": { "type": "string" },
            "xAxisDecimalPattern": { "type": "string" },
            "yAxisDecimalPattern": { "type": "string" },
            "seriesColors": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              }
            },
            "chartBackgroundColor": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "plotBackgroundColor": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "chartFontColor": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "fontFamily": { "type": "string" },
            "fontSize": { "type": "integer", "minimum": 1 },
            "antiAlias": { "type": "boolean" },
            "chartPadding": { "type": "integer" },
            "markerSize": { "type": "integer" },
            "circular": { "type": "boolean" },
            "forceAllLabelsVisible": { "type": "boolean" },
            "donutThickness": { "type": "number" },
            "startAngleInDegrees": { "type": "number" },
            "labelType": {
              "type": "string",
              "enum": ["Value", "Percentage", "Name", "NameAndPercentage", "NameAndValue"]
            }
          },
          "additionalProperties": false
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "description": "CategoryChart/XYChart series。每项必须使用 xField+yField 绑定顶层 data；seriesField 可按字段值动态拆成多系列。",
          "items": {
            "type": "object",
            "required": ["xField", "yField"],
            "properties": {
              "name": { "type": "string" },
              "xField": { "type": "string" },
              "yField": { "type": "string" },
              "seriesField": { "type": "string" },
              "renderStyle": {
                "type": "string",
                "description": "CategoryChart: Bar/Line/Area/Scatter/SteppedBar/Stick；XYChart: Line/Area/Step/StepArea/PolygonArea/Scatter；PieChart: Pie/Donut。"
              },
              "smooth": { "type": "boolean" },
              "lineColor": {
                "type": "string",
                "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "fillColor": {
                "type": "string",
                "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "markerColor": {
                "type": "string",
                "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "lineWidth": { "type": "number" },
              "showInLegend": { "type": "boolean" },
              "enabled": { "type": "boolean" },
              "label": { "type": "string" },
              "yAxisGroup": { "type": "integer" },
              "yAxisDecimalPattern": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "chartType": {
                "enum": ["CategoryChart", "XYChart"]
              }
            }
          },
          "then": {
            "required": ["series"]
          }
        },
        {
          "if": {
            "properties": {
              "chartType": {
                "const": "PieChart"
              }
            }
          },
          "then": {
            "required": ["nameField", "valueField"]
          }
        }
      ]
    },
    "xchartImage": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 100,
          "maximum": 4096,
          "default": 800
        },
        "height": {
          "type": "integer",
          "minimum": 100,
          "maximum": 4096,
          "default": 600
        },
        "format": {
          "type": "string",
          "enum": ["png", "jpg"],
          "default": "png"
        }
      },
      "additionalProperties": false
    },
    "echartsImage": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 100,
          "maximum": 4096,
          "default": 800
        },
        "height": {
          "type": "integer",
          "minimum": 100,
          "maximum": 4096,
          "default": 600
        },
        "format": {
          "type": "string",
          "enum": ["png", "svg"],
          "default": "png"
        }
      },
      "additionalProperties": false
    }
  }
}
