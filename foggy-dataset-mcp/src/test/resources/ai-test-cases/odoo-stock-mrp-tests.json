          {
            "tool": "dataset.query_model",
            "path": "groupBy",
            "field": "createDate$yearMonth",
            "must_exist": false
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "state",
            "value": "done",
