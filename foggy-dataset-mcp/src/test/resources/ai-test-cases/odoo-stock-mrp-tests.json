{
  "version": "1.0",
  "description": "Odoo stock/MRP optional AI route fixtures. Enable with AI_TEST_CASE_FILES=ai-test-cases/odoo-stock-mrp-tests.json when Odoo stock_picking and mrp_production demo data is available.",
  "testCases": [
    {
      "id": "ODOO-STOCK-001",
      "category": "FILTER_QUERY",
      "question": "查询所有已完成库存调拨，显示调拨单号、作业类型、调拨状态、计划时间和完成时间",
      "expected_tool": "dataset.query_model",
      "target_model": "OdooStockPickingQueryModel",
      "description": "Odoo 库存语义 - 已完成调拨使用库存调拨生命周期 state=done，完成时间 dateDone 只作为实际完成日期",
      "difficulty": "MEDIUM",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["name", "pickingType$caption", "pickingType$code", "state", "scheduledDate", "dateDone"],
          "slice": [
            {"field": "state", "op": "=", "value": "done"}
          ]
        }
      },
      "expected": {
        "required_columns": ["name", "pickingType$caption", "pickingType$code", "state", "scheduledDate", "dateDone"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "state",
            "value": "done",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "dateDone",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    },
    {
      "id": "ODOO-STOCK-002",
      "category": "FILTER_QUERY",
      "question": "查询所有等待处理或已就绪的库存调拨，显示调拨单号、作业类型、状态和计划时间",
      "expected_tool": "dataset.query_model",
      "target_model": "OdooStockPickingQueryModel",
      "description": "Odoo 库存语义 - 待处理/就绪调拨使用 stock.picking state，不用完成时间为空代替状态",
      "difficulty": "MEDIUM",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["name", "pickingType$caption", "pickingType$code", "state", "scheduledDate"],
          "slice": [
            {"field": "state", "op": "in", "value": ["waiting", "confirmed", "assigned"]}
          ]
        }
      },
      "expected": {
        "required_columns": ["name", "pickingType$caption", "pickingType$code", "state", "scheduledDate"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "state",
            "value": ["waiting", "confirmed", "assigned"],
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "dateDone",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    },
    {
      "id": "ODOO-STOCK-003",
      "category": "AGGREGATION",
      "question": "按计划月份统计库存调拨数量，显示计划月份和调拨单数量",
      "expected_tool": "dataset.query_model",
      "target_model": "OdooStockPickingQueryModel",
      "description": "Odoo 库存日期语义 - 计划期趋势使用 scheduledDate，不使用 createDate/writeDate 或完成时间",
      "difficulty": "MEDIUM",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["scheduledDate$yearMonth", "transferCount"],
          "groupBy": ["scheduledDate$yearMonth"],
          "orderBy": [
            {"column": "scheduledDate$yearMonth", "direction": "ASC"}
          ]
        }
      },
      "expected": {
        "required_columns": ["scheduledDate$yearMonth", "transferCount"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "groupBy",
            "field": "scheduledDate$yearMonth",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "groupBy",
            "field": "dateDone$yearMonth",
            "must_exist": false
          },
          {
            "tool": "dataset.query_model",
            "path": "groupBy",
            "field": "createDate$yearMonth",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    },
