    {
      "id": "FILTER-001",
      "category": "FILTER_QUERY",
      "question": "查询销售金额大于1000的记录",
      "expected_tool": "dataset.query_model",
      "target_model": "FactSalesQueryModel",
      "description": "过滤查询 - 数值条件",
      "difficulty": "MEDIUM",
      "direct_tool_arguments": {
        "payload": {
          "slice": [
            {"field": "salesAmount", "op": ">", "value": 1000}
          ]
        }
      },
      "expected": {
        "required_columns": ["salesAmount"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "salesAmount",
            "operator": ">",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "having",
            "field": "salesAmount",
            "operator": ">",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "VALUE_IN_RANGE",
            "column": "salesAmount",
            "params": {"min": 1000}
          }
        ]
      }
    },
    {
      "id": "FILTER-002",
      "category": "FILTER_QUERY",
      "question": "查询客户'客户1'的所有销售购买明细记录，显示商品名称、销售数量和销售金额",
      "expected_tool": "dataset.query_model",
      "target_model": "FactSalesQueryModel",
      "description": "过滤查询 - 文本精确匹配",
      "difficulty": "MEDIUM",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["customer$caption", "product$caption", "quantity", "salesAmount"],
          "slice": [
            {"field": "customer$caption", "op": "=", "value": "客户1"}
          ]
        }
      },
      "expected": {
        "required_columns": ["customer$caption", "product$caption", "quantity", "salesAmount"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "customer$caption",
            "operator": "=",
            "must_exist": true
          }
        ],
        "rules": [
          {
            "type": "VALUE_CONTAINS",
            "column": "customer$caption",
            "value": "客户1"
          }
        ]
      }
    },
    {
      "id": "ROUTE-ORDER-001",
      "category": "FILTER_QUERY",
      "question": "查询所有打开订单积压记录（订单状态为待处理、已确认或处理中），显示订单ID、订单状态、客户名称和订单应付金额",
      "expected_tool": "dataset.query_model",
      "target_model": "FactOrderQueryModel",
      "description": "路由意图 - 订单积压应使用订单事实模型而不是销售明细模型",
      "difficulty": "MEDIUM",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["orderId", "orderStatus", "customer$caption", "payAmount"],
          "slice": [
            {"field": "orderStatus", "op": "in", "value": ["PENDING", "CONFIRMED", "PROCESSING"]}
          ]
        }
      },
      "expected": {
        "required_columns": ["orderId", "orderStatus", "customer$caption", "payAmount"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "orderStatus",
            "value": ["PENDING", "CONFIRMED", "PROCESSING"],
            "must_exist": true
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    },
