{
  "version": "1.0",
  "description": "Odoo sales/purchase optional AI route fixtures. Enable with AI_TEST_CASE_FILES=ai-test-cases/ecommerce-tests.json,ai-test-cases/odoo-sales-purchase-tests.json when Odoo sale_order and purchase_order demo data is available.",
  "testCases": [
    {
      "id": "ODOO-SALE-001",
      "category": "FILTER_QUERY",
      "question": "查询所有已确认销售订单，显示订单号、客户、订单状态、开票状态和订单金额",
      "expected_tool": "dataset.query_model",
      "target_model": "OdooSaleOrderQueryModel",
      "description": "Odoo 销售语义 - 已确认销售订单使用销售生命周期 state，不使用开票状态",
      "difficulty": "MEDIUM",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["name", "partner$caption", "state", "invoiceStatus", "amountTotal"],
          "slice": [
            {"field": "state", "op": "in", "value": ["sale", "done"]}
          ]
        }
      },
      "expected": {
        "required_columns": ["name", "partner$caption", "state", "invoiceStatus", "amountTotal"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "state",
            "value": ["sale", "done"],
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "invoiceStatus",
            "value": "invoiced",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    },
    {
