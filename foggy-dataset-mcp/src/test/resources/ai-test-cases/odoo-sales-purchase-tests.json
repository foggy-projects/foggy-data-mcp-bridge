          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "invoiceMove$moveType",
            "value": "out_invoice",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "deliveryPicking$origin",
            "must_exist": false
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "invoiceMove$invoiceOrigin",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    },
    {
      "id": "ODOO-SALE-XDOC-002",
      "category": "FILTER_QUERY",
      "question": "查询已经出库且已有客户收款但发票仍未完全结清的销售单据流，显示销售单号、客户、出库单、客户发票号、发票付款状态、未收余额和收款金额",
      "expected_tool": "dataset.query_model",
      "target_model": "OdooSaleDocumentFlowQueryModel",
      "description": "Odoo 销售跨单据语义 - 已出库使用库存出库 state=done，未完全回款使用客户发票 paymentState，客户收款使用 inbound/customer",
      "difficulty": "HARD",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["saleOrder$caption", "customer$caption", "deliveryPicking$caption", "invoiceMove$caption", "invoiceMove$paymentState", "invoiceMove$amountResidual", "payment$amount"],
          "slice": [
            {"field": "saleOrder$state", "op": "in", "value": ["sale", "done"]},
            {"field": "deliveryPicking$state", "op": "=", "value": "done"},
            {"field": "invoiceMove$moveType", "op": "=", "value": "out_invoice"},
            {"field": "invoiceMove$paymentState", "op": "in", "value": ["partial", "in_payment"]},
            {"field": "payment$paymentType", "op": "=", "value": "inbound"},
            {"field": "payment$partnerType", "op": "=", "value": "customer"}
          ]
        }
      },
      "expected": {
        "required_columns": ["saleOrder$caption", "customer$caption", "deliveryPicking$caption", "invoiceMove$caption", "invoiceMove$paymentState", "invoiceMove$amountResidual", "payment$amount"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "saleOrder$state",
            "value": ["sale", "done"],
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "deliveryPicking$state",
            "value": "done",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "invoiceMove$moveType",
            "value": "out_invoice",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "invoiceMove$paymentState",
            "value": ["partial", "in_payment"],
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "payment$paymentType",
            "value": "inbound",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "payment$partnerType",
            "value": "customer",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "saleOrder$state",
            "value": "paid",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    }
  ]
