    {
      "id": "ODOO-PURCHASE-XDOC-001",
      "category": "FILTER_QUERY",
      "question": "查询采购订单对应的收货单和供应商账单，显示采购单号、供应商、收货单、收货状态、账单号、账单类型、账单付款状态和账单余额",
      "expected_tool": "dataset.query_model",
      "target_model": "OdooPurchaseDocumentFlowQueryModel",
      "description": "Odoo 采购跨单据语义 - 使用显式采购单据流连接采购订单、收货单和供应商账单",
      "difficulty": "HARD",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["purchaseOrder$caption", "vendor$caption", "receiptPicking$caption", "receiptPicking$state", "billMove$caption", "billMove$moveType", "billMove$paymentState", "billMove$amountResidual"],
          "slice": [
            {"field": "purchaseOrder$state", "op": "in", "value": ["purchase", "done"]},
            {"field": "billMove$moveType", "op": "=", "value": "in_invoice"}
          ]
        }
      },
      "expected": {
        "required_columns": ["purchaseOrder$caption", "vendor$caption", "receiptPicking$caption", "receiptPicking$state", "billMove$caption", "billMove$moveType", "billMove$paymentState", "billMove$amountResidual"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "purchaseOrder$state",
            "value": ["purchase", "done"],
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "billMove$moveType",
            "value": "in_invoice",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "receiptPicking$origin",
            "must_exist": false
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "billMove$invoiceOrigin",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    },
    {
      "id": "ODOO-PURCHASE-XDOC-002",
      "category": "FILTER_QUERY",
      "question": "查询已经收货但供应商账单仍未付款的采购单据流，显示采购单号、供应商、收货单、账单号、账单付款状态和未付余额",
      "expected_tool": "dataset.query_model",
      "target_model": "OdooPurchaseDocumentFlowQueryModel",
      "description": "Odoo 采购跨单据语义 - 已收货使用库存收货 state=done，未付款使用供应商账单 paymentState，不使用采购 state 代替付款状态",
      "difficulty": "HARD",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["purchaseOrder$caption", "vendor$caption", "receiptPicking$caption", "billMove$caption", "billMove$paymentState", "billMove$amountResidual"],
          "slice": [
            {"field": "purchaseOrder$state", "op": "in", "value": ["purchase", "done"]},
            {"field": "receiptPicking$state", "op": "=", "value": "done"},
            {"field": "billMove$moveType", "op": "=", "value": "in_invoice"},
            {"field": "billMove$paymentState", "op": "in", "value": ["not_paid", "partial", "in_payment"]}
          ]
        }
      },
      "expected": {
        "required_columns": ["purchaseOrder$caption", "vendor$caption", "receiptPicking$caption", "billMove$caption", "billMove$paymentState", "billMove$amountResidual"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "purchaseOrder$state",
            "value": ["purchase", "done"],
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "receiptPicking$state",
            "value": "done",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "billMove$moveType",
            "value": "in_invoice",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "billMove$paymentState",
            "value": ["not_paid", "partial", "in_payment"],
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "purchaseOrder$state",
            "value": "paid",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    },
    {
      "id": "ODOO-SALE-XDOC-001",
