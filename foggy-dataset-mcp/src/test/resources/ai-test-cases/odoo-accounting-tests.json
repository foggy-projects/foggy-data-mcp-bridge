{
  "version": "1.0",
  "description": "Odoo accounting/payment optional AI route fixtures. Enable with AI_TEST_CASE_FILES=ai-test-cases/ecommerce-tests.json,ai-test-cases/odoo-accounting-tests.json when Odoo demo data is available.",
  "testCases": [
    {
      "id": "ODOO-ACC-001",
      "category": "FILTER_QUERY",
      "question": "查询所有已过账但未完全收款的客户发票，显示发票号、客户、付款状态和未收金额",
      "expected_tool": "dataset.query_model",
      "target_model": "OdooAccountMoveQueryModel",
      "description": "Odoo 会计语义 - 已过账是单据生命周期，未完全收款是付款结算状态",
      "difficulty": "MEDIUM",
      "direct_tool_arguments": {
        "payload": {
          "columns": ["name", "partner$caption", "state", "paymentState", "amountResidual"],
          "slice": [
            {"field": "moveType", "op": "=", "value": "out_invoice"},
            {"field": "state", "op": "=", "value": "posted"},
            {"field": "paymentState", "op": "in", "value": ["not_paid", "partial", "in_payment"]}
          ]
        }
      },
      "expected": {
        "required_columns": ["name", "partner$caption", "state", "paymentState", "amountResidual"],
        "tool_argument_rules": [
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "moveType",
            "value": "out_invoice",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "state",
            "value": "posted",
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "paymentState",
            "value": ["not_paid", "partial", "in_payment"],
            "must_exist": true
          },
          {
            "tool": "dataset.query_model",
            "path": "slice",
            "field": "state",
            "value": "paid",
            "must_exist": false
          }
        ],
        "rules": [
          {
            "type": "NOT_EMPTY"
          }
        ]
      }
    },
