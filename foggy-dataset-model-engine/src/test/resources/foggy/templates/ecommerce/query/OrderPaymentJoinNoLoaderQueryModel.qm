/**
 * QM v2 default-builder regression model.
 *
 * Verifies that loadTableModel + joins syntax is accepted by the default V2 path.
 */
const fo = loadTableModel('FactOrderModel');
const fp = loadTableModel('FactPaymentModel');

export const queryModel = {
    name: 'OrderPaymentJoinNoLoaderQueryModel',
    caption: '订单支付联合查询（默认 V2）',
    description: 'QM v2 syntax through the default builder path',

    model: fo,
    joins: [
        fo.leftJoin(fp).on(fo.orderId, fp.orderId)
    ],

    columnGroups: [
        {
            caption: '订单信息',
            items: [
                { ref: fo.orderId },
                { ref: fo.orderStatus }
            ]
        },
        {
            caption: '支付信息',
            items: [
                { ref: fp.paymentId },
                { ref: fp.payAmount }
            ]
        }
    ]
};
